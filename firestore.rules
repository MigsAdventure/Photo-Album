rules_version = '2';

// SharedMoments Firestore security rules
//
// Context: this application has no user authentication. Guests open an event URL
// and upload; organizers are identified only by an email address on the event
// document. That means these rules CANNOT establish identity. What they can do —
// and what they are written to do — is make the paths that cost money or destroy
// data unreachable from a browser:
//
//   * plan state (planType, photoLimit, paymentId) is writable only by the
//     Admin SDK, so an event cannot be upgraded to premium from the console
//   * photo and event documents cannot be deleted by a client at all; deletion
//     goes through netlify/functions/delete-photo.js, which removes the Firestore
//     document, the Storage object and the R2 object as one unit
//   * photoCount can only move by exactly one, so it cannot be reset or inflated
//   * downloadJobs (rate limiting and job dedupe) is invisible to clients
//
// Anything reachable without authentication is still forgeable in its details —
// a client can write a photo document claiming any uploadedBy value. Ownership is
// therefore advisory for UI purposes and must never gate a destructive or billable
// operation. Real identity arrives with magic-link auth in Phase 4 (UX-2), at
// which point these rules should be revisited to key on request.auth.token.email.
//
// Refs: AUDIT_2026-08.md SEC-2, SEC-5, SEC-7

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    // The set of field names whose values differ between the stored document and
    // the incoming one.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // Is the caller signed in as the organizer of this event?
    //
    // New in Phase 4. Until magic-link sign-in existed there was no identity to
    // check, so every organizer action had to go through a server function
    // holding a secret. Email-link sign-in proves control of the mailbox, which
    // is exactly the claim the organizerEmail field encodes.
    //
    // Emails are compared lowercased because Firebase preserves the case the
    // user typed while our events store whatever was entered at creation.
    function isOrganizerOf(eventData) {
      return request.auth != null
             && request.auth.token.email_verified == true
             && eventData.organizerEmail is string
             && request.auth.token.email.lower() == eventData.organizerEmail.lower();
    }

    // Fields an organizer may edit on their own event. Deliberately excludes
    // everything that decides what they have paid for.
    function organizerEditableFields() {
      return ['title', 'date', 'isActive', 'customBranding', 'coverPhotoId', 'updatedAt'];
    }

    // ----------------------------------------------------------------- events

    match /events/{eventId} {

      // Galleries are public by design — anyone with the link can view.
      allow get: if true;

      // Listing is restricted to your own events. Firestore evaluates this
      // against the query rather than the results, so the client query must
      // carry a matching where('organizerEmail','==',...) clause or the whole
      // query is refused — which is what stops this becoming an enumeration of
      // every wedding across every customer.
      allow list: if request.auth != null
                  && request.auth.token.email_verified == true
                  && resource.data.organizerEmail is string
                  && request.auth.token.email.lower() == resource.data.organizerEmail.lower();

      // Anyone may create an event, but only ever a free one. This closes the
      // "create a premium event directly" path that would otherwise sidestep
      // payment entirely.
      allow create: if isString(request.resource.data.title, 200)
                    && isString(request.resource.data.date, 30)
                    && isString(request.resource.data.organizerEmail, 320)
                    && request.resource.data.planType == 'free'
                    && request.resource.data.photoLimit is int
                    && request.resource.data.photoCount == 0
                    && request.resource.data.isActive == true
                    && request.resource.data.createdAt is timestamp;

      // Guests write nothing. photoCount used to be client-incremented after
      // each upload; since uploads became server-side (upload-complete.js
      // increments, delete-photo.js decrements) there is no guest write left.
      //
      // That also fixed a silent bug: the count and the gallery could disagree,
      // because the upload wrote the photo document and then made a *separate*
      // client write to bump the count. A guest closing the tab in between left
      // the event permanently miscounted.
      //
      // A signed-in organizer may edit the presentation of their own event —
      // title, date, branding, whether it is open — but nothing that decides
      // what they have paid for. planType, photoLimit, paymentId and photoCount
      // stay Admin-SDK-only, so an organizer cannot grant themselves premium
      // any more than a guest could.
      allow update: if isOrganizerOf(resource.data)
                    && isOrganizerOf(request.resource.data)
                    && changedKeys().hasOnly(organizerEditableFields());

      // Events are never deleted from a client. Retention and takedown are
      // operational actions performed with the Admin SDK.
      allow delete: if false;
    }

    // ----------------------------------------------------------------- photos

    match /photos/{photoId} {

      // The gallery reads photos by eventId, so both get and list are needed.
      // Scoping the list to a single event is not expressible in rules; the
      // application always queries with a where('eventId','==',…) clause, and the
      // exposure is the same as the public gallery it feeds.
      allow read: if true;

      // Photo documents are written exclusively by
      // netlify/functions/upload-complete.js, using the Admin SDK, after it has
      // verified the object exists in R2 at the size we authorised.
      //
      // Clients previously created these themselves, which forced the rules to
      // guess at validity from the document's shape alone — the server could not
      // confirm that the bytes behind a document existed, so a failed upload
      // left a broken tile in the gallery pointing at nothing. Now the document
      // cannot exist unless the object does.
      //
      // It also removes the last place a client could influence r2Key, which was
      // the one field capable of pointing the gallery at an arbitrary object in
      // the bucket.
      allow create: if false;

      // The only update that happens is the server stamping r2Key, which uses the
      // Admin SDK. Nothing legitimate updates a photo from a browser.
      allow update: if false;

      // Deletion goes through netlify/functions/delete-photo.js so that Firestore,
      // Firebase Storage and R2 are cleaned up together. A client delete here
      // would orphan the bytes in two stores while making the photo vanish from
      // the gallery — which is exactly what finding SEC-7 describes.
      allow delete: if false;
    }

    // ----------------------------------------------------------- downloadJobs

    // Written only by the Admin SDK. Backs durable rate limiting and archive
    // dedupe for the email-download endpoint (SEC-4). Invisible to clients so a
    // caller cannot read the counters they are being limited by, or clear them.
    match /downloadJobs/{jobId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------- catch-all

    // Any collection added later is denied until someone writes a rule for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
